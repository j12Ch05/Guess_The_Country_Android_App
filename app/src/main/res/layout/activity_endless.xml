<?xml version="1.0" encoding="utf-8"?>
 <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     xmlns:tools="http://schemas.android.com/tools"
     android:id="@+id/endless"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="#61A4AB"
     tools:context=".MainActivity">

    <TextView
        android:id="@+id/high"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="44dp"
        android:layout_marginTop="15dp"
        android:textColor="#FFFFFF"
        android:text="High Score"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/highScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:gravity="center"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="43dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/high"/>

    <androidx.cardview.widget.CardView
        android:id = "@+id/flag"
        android:layout_width="240dp"
        android:layout_height="140dp"
        android:layout_marginTop="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/highScore">

        <ImageView
            android:id="@+id/flagImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Country flag"
            android:scaleType="fitXY"
            android:src="@drawable/usa"
            android:visibility="visible"/>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/currentScore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="0"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="42sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/flag"/>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btAns1"
        android:layout_width="255dp"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:text="Answer 1"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:backgroundTint="#1E3E47"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/currentScore"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btAns2"
        android:layout_width="255dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="Answer 2"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:backgroundTint="#1E3E47"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btAns1"/>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btAns3"
        android:layout_width="255dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="Answer 3"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:backgroundTint="#1E3E47"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btAns2"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btAns4"
        android:layout_width="255dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="Answer 4"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:backgroundTint="#1E3E47"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btAns3"/>





</androidx.constraintlayout.widget.ConstraintLayout>